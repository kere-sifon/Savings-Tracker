# Copy to .env.local and fill in. On Vercel, set these in Project → Settings → Environment Variables.

# openssl rand -base64 32 — required for login + middleware (both must use the same value)
NEXTAUTH_SECRET=
# Optional alias (same value as NEXTAUTH_SECRET if you use this instead)
# AUTH_SECRET=

# Local: http://localhost:3000  |  Production: https://your-app.vercel.app
NEXTAUTH_URL=http://localhost:3000

# Savings app data + users (same database)
# MONGODB_SAVINGS_URI=
# or
# MONGODB_URI=

# Kids module (required if you use /kids)
# MONGODB_KIDS_URI=

# First admin: open /auth/setup when the User collection is empty, or run:
# npm run create-user -- you@example.com yourpassword admin

# --- Vercel ---
# After first deploy, set NEXTAUTH_URL to your production URL, e.g. https://your-project.vercel.app
# Add all variables above in Project → Settings → Environment Variables (Production + Preview as needed).
